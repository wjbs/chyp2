@top Document { statement* }

@top SingleTerm { Term }

statement {
  Import |
  Gen |
  Let |
  Def |
  Rule |
  Rewrite |
  Show
}

Import {
  kw<"import"> Identifier (kw<"as"> Identifier)?
  ("(" (ImportLet (Comma ImportLet)*)? ")")?
}

Gen {
  kw<"gen"> Identifier Colon Nat Arrow Nat GenColor?
}

Let {
  kw<"let"> Identifier Eq Term
}

Def {
  kw<"def"> Identifier Eq Term GenColor?
}

Rule {
  kw<"rule"> Identifier Colon Term Eq Term
}

Rewrite {
  kw<"rewrite"> Identifier Colon Term RewritePart*
}

Show {
  kw<"show"> RuleRef
}

ImportLet { Identifier Eq Term }

GenColor { HexColor HexColor? }

RewritePart { Eq TermHole (kw<"by"> Tactic)? }

TermHole { Question | Term }

Term { ParTerm (Semicolon ParTerm)* }

ParTerm { atomicTerm (Star atomicTerm)* }

atomicTerm {
  "(" Term ")" |
  Perm |
  kw<"id"> |
  kw<"id0"> |
  TermRef
}

Perm { kw<"sw"> "[" Nat (Comma Nat)* "]" }

Tactic {
  (kw<"rule"> | Minus? Identifier) ("(" (TacticArg (Comma TacticArg)*)? ")")?
}

TacticArg { (Plus | Minus)? Identifier }

TermRef { Identifier }
RuleRef { Identifier }

kw<term> { @specialize[@name={term}]<Identifier, term> }

@skip { spaces | Comment }

@tokens {
  spaces { $[ \t\n\r]+ }
  Comment { "#" ![\n]* }
  Nat { $[0-9]+ }
  HexColor { '"' $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] $[0-9a-fA-F] '"' }
  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_.]* }
  Colon { ":" }
  Arrow { "->" }
  Eq { "=" }
  Plus { "+" }
  Minus { "-" }
  Semicolon { ";" }
  Star { "*" }
  Comma { "," }
  Question { "?" }
}
