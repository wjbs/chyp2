{
  "name": "chyp2",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./lib/*": {
      "import": "./js/lib/*.js",
      "types": "./js/lib/*.d.ts"
    },
    "./gui/*": {
      "import": "./js/gui/*.js",
      "types": "./js/gui/*.d.ts"
    },
    "./gui/index.css": "./js/gui/index.css",
    "./gui/style.css": "./js/gui/index.css"
  },
  "files": [
    "js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "rm -rf js && tsc -p tsconfig.lib.json && cp src/gui/index.css js/gui/index.css",
    "preview": "vite preview",
    "test": "mocha",
    "prepare": "lezer-generator --typeScript src/lib/chyp.grammar -o src/lib/parser.ts",
    "start": "npx node src/server.js"
  },
  "peerDependencies": {
    "@codemirror/language": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6",
    "@lezer/highlight": ">=1",
    "codemirror": ">=6",
    "preact": ">=10"
  },
  "dependencies": {
    "@lezer/lr": "^1.0.0",
    "@preact/signals": "^1.3.0",
    "codemirror": ">=6",
    "dododir": "github:akissinger/dododir",
    "dotenv": "^17.4.2",
    "lucide-preact": "^1.17.0",
    "preact": ">=10",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@lezer/generator": "^1.0.0",
    "@preact/preset-vite": "^2.10.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.3",
    "mocha": "^11.7.6",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
